{
  "name": "tracery",
  "version": "0.1.0",
  "private": true,
  "description": "Fire ASCII art, text or images into colored terminal block banners and MOTDs.",
  "type": "module",
  "bin": {
    "tracery": "dist/cli/tracery.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.cli.config.ts",
    "build:web": "vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tracery": "node dist/cli/tracery.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
