{
  "name": "tracery",
  "version": "0.1.0",
  "private": true,
  "description": "Fire ASCII art, text or images into colored terminal block banners and MOTDs.",
  "type": "module",
  "bin": {
    "tracery": "dist/cli/tracery.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check && vite build && vite build --config vite.cli.config.ts",
    "build:web": "vite build",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "typecheck": "svelte-check",
    "test": "vite build --config vite.cli.config.ts && node --test test/*.test.mjs",
    "tracery": "node dist/cli/tracery.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
